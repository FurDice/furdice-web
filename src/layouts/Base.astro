---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, DEFAULT_LANG, SITE, localePath, type Lang } from '../data/site';
import { t } from '../data/ui';

interface Props {
  lang: Lang;
  /** 언어 접두사 없는 경로. 예: '/', '/games/there-were-eggs/' */
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const { lang, path, title, description, ogImage = '/og.png', ogType = 'website', jsonLd, noindex = false } = Astro.props;
const canonical = new URL(localePath(lang, path), SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const ogLocale = { en: 'en_US', ko: 'ko_KR', ja: 'ja_JP' }[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), SITE.url).href} />)}
        <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LANG, path), SITE.url).href} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
